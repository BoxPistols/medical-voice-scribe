# どちらか一方でもあれば起動する。両方あるとモデルセレクタに両方が出る。

# OpenAI (推奨)
# https://platform.openai.com/api-keys
# 医療辞書のセマンティック検索は埋め込みを使うため、こちらが無いと辞書検索は無効になる
OPENAI_API_KEY=sk-your-api-key-here

# Gemini (任意)
# https://aistudio.google.com/apikey
# Flash系は無料枠があるので、OpenAIの有料アカウントが無くても一通り試せる
GEMINI_API_KEY=

# 為替と価格の上書き (任意)
# NEXT_PUBLIC_USD_TO_JPY=150
# NEXT_PUBLIC_MODEL_PRICING={"gemini-3.6-flash":{"input":1.5,"output":7.5}}
